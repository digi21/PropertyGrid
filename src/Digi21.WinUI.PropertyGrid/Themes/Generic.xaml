<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pg="using:Digi21.WinUI.PropertyGrid"
    xmlns:primitives="using:Digi21.WinUI.PropertyGrid.Primitives">

    <!--
        Every control gets an implicit style chaining to a keyed default, so an application can
        derive from the default with BasedOn instead of copying the whole template out of the source.

        Nothing here declares a colour or a size: they all come from PropertyGridResources.xaml,
        which is merged into the application's resources so that the application wins.
    -->

    <Style BasedOn="{StaticResource DefaultPropertyGridStyle}" TargetType="pg:PropertyGrid" />
    <Style BasedOn="{StaticResource DefaultPropertyGridRowPresenterStyle}" TargetType="primitives:PropertyGridRowPresenter" />
    <Style BasedOn="{StaticResource DefaultPropertyGridCategoryHeaderStyle}" TargetType="primitives:PropertyGridCategoryHeader" />
    <Style BasedOn="{StaticResource DefaultPropertyGridSplitterStyle}" TargetType="primitives:PropertyGridSplitter" />
    <Style BasedOn="{StaticResource DefaultPropertyGridDescriptionPaneStyle}" TargetType="primitives:PropertyGridDescriptionPane" />
    <Style BasedOn="{StaticResource DefaultPropertyGridColorEditorStyle}" TargetType="primitives:PropertyGridColorEditor" />
    <Style BasedOn="{StaticResource DefaultPropertyGridPathEditorStyle}" TargetType="primitives:PropertyGridPathEditor" />
    <Style BasedOn="{StaticResource DefaultPropertyGridDialogEditorStyle}" TargetType="primitives:PropertyGridDialogEditor" />

    <!--
        The expander in the name cell. A toggle button with its chrome taken away: the default one
        fills itself with the accent colour when checked, which in a list of rows reads as a
        selection rather than as "this is open".
    -->
    <Style x:Key="PropertyGridExpanderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="2">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two structural row templates the repeater chooses between. -->
    <DataTemplate x:Key="DefaultPropertyGridPropertyRowTemplate">
        <primitives:PropertyGridRowPresenter />
    </DataTemplate>

    <DataTemplate x:Key="DefaultPropertyGridCategoryHeaderTemplate">
        <primitives:PropertyGridCategoryHeader />
    </DataTemplate>

    <pg:PropertyGridRowTemplateSelector
        x:Key="DefaultPropertyGridRowTemplateSelector"
        CategoryHeaderTemplate="{StaticResource DefaultPropertyGridCategoryHeaderTemplate}"
        PropertyTemplate="{StaticResource DefaultPropertyGridPropertyRowTemplate}" />

    <Style x:Key="DefaultPropertyGridStyle" TargetType="pg:PropertyGrid">
        <Setter Property="Background" Value="{ThemeResource PropertyGridBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PropertyGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PropertyGridBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource PropertyGridCornerRadius}" />
        <Setter Property="NameColumnWidth" Value="{ThemeResource PropertyGridNameColumnWidth}" />
        <Setter Property="MinimumNameColumnWidth" Value="{ThemeResource PropertyGridMinimumNameColumnWidth}" />
        <Setter Property="MinimumValueColumnWidth" Value="{ThemeResource PropertyGridMinimumValueColumnWidth}" />
        <Setter Property="IndentSize" Value="{ThemeResource PropertyGridIndentSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="pg:PropertyGrid">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Its text and its visibility are wired in code rather than bound: a
                                classic binding does not convert a bool to a Visibility, and the
                                alternative is shipping a converter for two lines of plumbing.
                            -->
                            <AutoSuggestBox
                                x:Name="PART_SearchBox"
                                Margin="6"
                                PlaceholderText="{ThemeResource PropertyGridSearchPlaceholderText}"
                                QueryIcon="Find"
                                Visibility="Collapsed" />

                            <!--
                                The splitter is a sibling of the scroller rather than a child of it,
                                so it spans the whole height as one unbroken line and never scrolls
                                out of view. That only stays lined up while the rows cannot scroll
                                sideways, which the control also enforces from code.
                            -->
                            <Grid Grid.Row="1">
                                <ScrollViewer
                                    x:Name="PART_ScrollViewer"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Auto">
                                    <ItemsRepeater
                                        x:Name="PART_ItemsRepeater"
                                        ItemTemplate="{StaticResource DefaultPropertyGridRowTemplateSelector}"
                                        VerticalCacheLength="3">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <primitives:PropertyGridSplitter
                                    x:Name="PART_Splitter"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" />
                            </Grid>

                            <primitives:PropertyGridDescriptionPane x:Name="PART_DescriptionPane" Grid.Row="2" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridRowPresenterStyle" TargetType="primitives:PropertyGridRowPresenter">
        <!--
            MinHeight, not Height. A row has to be able to grow with an editor taller than a line -
            a thumbnail, a wrapped note, a stack of buttons - and a fixed Height clips it silently.
            There is no way to undo one from outside either: a Setter for a double does not parse
            "Auto", so a consumer would have to copy this entire template to get rid of it.

            Uniform rows still measure 28: the row panel asks its cells what they want and a
            single-line editor wants a line. And StackLayout measures every row rather than
            assuming they match, so virtualization is unaffected - verified with 400 rows in the
            gallery's diagnose mode.
        -->
        <Setter Property="MinHeight" Value="{ThemeResource PropertyGridRowHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Rows take focus so the keyboard can reach them, and show where it is when it does. -->
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridRowPresenter">
                    <Border x:Name="Root" Background="{ThemeResource PropertyGridRowBackgroundBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource PropertyGridRowPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource PropertyGridRowSelectedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ValidationStates">
                                <VisualState x:Name="Valid" />
                                <VisualState x:Name="Invalid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ErrorIcon.Visibility" Value="Visible" />
                                        <Setter Target="EditorBorder.BorderBrush" Value="{ThemeResource PropertyGridErrorBorderBrush}" />
                                        <Setter Target="EditorBorder.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="NotExpandable">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Expander.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ExpanderGlyph.Glyph" Value="{ThemeResource PropertyGridCollapsedGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="ExpanderGlyph.Glyph" Value="{ThemeResource PropertyGridExpandedGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!--
                            Three cells, laid out by position rather than by a Grid: a repeater
                            measures every row on its own and WinUI has neither a shared size scope
                            nor an ancestor binding, so the width has to be pushed in by the owner.
                        -->
                        <primitives:PropertyGridRowPanel x:Name="PART_RowPanel">
                            <Border x:Name="PART_NameCell" Padding="{ThemeResource PropertyGridNamePadding}">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton
                                        x:Name="PART_Expander"
                                        Width="{ThemeResource PropertyGridExpanderSize}"
                                        Height="{ThemeResource PropertyGridExpanderSize}"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropertyGridExpanderToggleStyle}">
                                        <FontIcon
                                            x:Name="ExpanderGlyph"
                                            FontFamily="{ThemeResource PropertyGridIconFontFamily}"
                                            FontSize="{ThemeResource PropertyGridIconFontSize}"
                                            Foreground="{ThemeResource PropertyGridExpanderGlyphBrush}"
                                            Glyph="{ThemeResource PropertyGridCollapsedGlyph}" />
                                    </ToggleButton>

                                    <FontIcon
                                        x:Name="PART_ErrorIcon"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource PropertyGridIconFontFamily}"
                                        FontSize="{ThemeResource PropertyGridIconFontSize}"
                                        Foreground="{ThemeResource PropertyGridErrorForegroundBrush}"
                                        Glyph="{ThemeResource PropertyGridErrorGlyph}"
                                        Visibility="Collapsed" />

                                    <TextBlock
                                        x:Name="PART_NameText"
                                        Foreground="{ThemeResource PropertyGridNameForegroundBrush}"
                                        Style="{ThemeResource PropertyGridNameTextStyle}"
                                        Text="{Binding DisplayName}"
                                        ToolTipService.ToolTip="{Binding DisplayName}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="PART_Gutter" Background="Transparent">
                                <Rectangle
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="{ThemeResource PropertyGridColumnRuleBrush}" />
                            </Border>

                            <Border x:Name="EditorBorder" CornerRadius="2">
                                <ContentPresenter
                                    x:Name="PART_EditorHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center" />
                            </Border>
                        </primitives:PropertyGridRowPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridCategoryHeaderStyle" TargetType="primitives:PropertyGridCategoryHeader">
        <Setter Property="MinHeight" Value="{ThemeResource PropertyGridCategoryHeaderHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridCategoryHeader">
                    <Border
                        x:Name="Root"
                        Padding="6,0,6,0"
                        Background="{ThemeResource PropertyGridCategoryBackgroundBrush}"
                        BorderBrush="{ThemeResource PropertyGridCategoryBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource PropertyGridRowPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderGlyph.Glyph" Value="{ThemeResource PropertyGridExpandedGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderGlyph.Glyph" Value="{ThemeResource PropertyGridCollapsedGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                x:Name="PART_ExpanderGlyph"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource PropertyGridIconFontFamily}"
                                FontSize="{ThemeResource PropertyGridIconFontSize}"
                                Foreground="{ThemeResource PropertyGridExpanderGlyphBrush}"
                                Glyph="{ThemeResource PropertyGridExpandedGlyph}" />

                            <TextBlock
                                x:Name="PART_Title"
                                Foreground="{ThemeResource PropertyGridCategoryForegroundBrush}"
                                Style="{ThemeResource PropertyGridCategoryTextStyle}"
                                Text="{Binding DisplayName}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridSplitterStyle" TargetType="primitives:PropertyGridSplitter">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridSplitter">
                    <!-- Transparent rather than unpainted: an unpainted band takes no pointer input. -->
                    <Border x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Grip.Fill" Value="{ThemeResource PropertyGridSplitterPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Grip.Fill" Value="{ThemeResource PropertyGridSplitterPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle
                            x:Name="PART_Grip"
                            Width="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource PropertyGridSplitterBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridDialogEditorStyle" TargetType="primitives:PropertyGridDialogEditor">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridDialogEditor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Read-only on purpose. What this editor is for is values with no text form
                            worth typing - a list, an object, something only a dialog can express.
                            A value you can type gets a text editor instead.
                        -->
                        <TextBlock
                            Padding="{ThemeResource PropertyGridEditorPadding}"
                            Foreground="{ThemeResource PropertyGridReadOnlyForegroundBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{ThemeResource PropertyGridValueTextStyle}"
                            Text="{Binding Text}" />

                        <Button
                            x:Name="PART_EditButton"
                            Grid.Column="1"
                            Width="28"
                            MinWidth="0"
                            Margin="2,0,0,0"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="{ThemeResource PropertyGridEditToolTipText}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{ThemeResource PropertyGridEditToolTipText}"
                            Visibility="Collapsed">
                            <FontIcon
                                FontFamily="{ThemeResource PropertyGridIconFontFamily}"
                                FontSize="{ThemeResource PropertyGridIconFontSize}"
                                Glyph="{ThemeResource PropertyGridEllipsisGlyph}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridPathEditorStyle" TargetType="primitives:PropertyGridPathEditor">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridPathEditor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            VerticalAlignment="Center"
                            primitives:TextEditorBehaviors.CommitOnEnter="True"
                            primitives:TextEditorBehaviors.SelectAllOnFocus="True"
                            BorderThickness="0"
                            IsReadOnly="{Binding IsReadOnly}"
                            Padding="{ThemeResource PropertyGridEditorPadding}"
                            Text="{Binding Text, Mode=TwoWay}" />

                        <!--
                            The button only raises BrowseRequested. Typing a path by hand still
                            works, which matters for a path that does not exist yet and for anyone
                            pasting one in.
                        -->
                        <Button
                            x:Name="PART_BrowseButton"
                            Grid.Column="1"
                            Width="28"
                            MinWidth="0"
                            Margin="2,0,0,0"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="{ThemeResource PropertyGridBrowseToolTipText}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{ThemeResource PropertyGridBrowseToolTipText}">
                            <FontIcon
                                FontFamily="{ThemeResource PropertyGridIconFontFamily}"
                                FontSize="{ThemeResource PropertyGridIconFontSize}"
                                Glyph="{ThemeResource PropertyGridEllipsisGlyph}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridColorEditorStyle" TargetType="primitives:PropertyGridColorEditor">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridColorEditor">
                    <!--
                        The swatch is a direct child of the template root, not the button's content:
                        an element nested inside another control's content is outside the namescope
                        GetTemplateChild searches, so the control could never find it to paint it.
                        The button sits on top, transparent, and only provides the border and the
                        flyout.
                    -->
                    <Grid Width="40" Height="20">
                        <!--
                            A light backdrop under the swatch, so a colour with alpha reads as
                            translucent rather than as a slightly different opaque colour.
                        -->
                        <Rectangle Fill="{ThemeResource ControlFillColorInputActiveBrush}" />

                        <!-- Painted from code: see PropertyGridColorEditor.UpdateSwatch. -->
                        <Rectangle x:Name="PART_Swatch" />

                        <Button
                            x:Name="PART_OpenButton"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="{ThemeResource PropertyGridColorSwatchBorderBrush}"
                            BorderThickness="1">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <!--
                                        A flyout builds its content lazily and in its own namescope,
                                        so these are found by name off the flyout when it opens
                                        rather than by GetTemplateChild.
                                    -->
                                    <StackPanel Spacing="8">
                                        <ColorPicker
                                            x:Name="PART_Picker"
                                            IsAlphaEnabled="True"
                                            IsMoreButtonVisible="True" />
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                x:Name="PART_Confirm"
                                                Content="{ThemeResource PropertyGridOkButtonText}"
                                                Style="{ThemeResource AccentButtonStyle}" />
                                            <Button x:Name="PART_Cancel" Content="{ThemeResource PropertyGridCancelButtonText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPropertyGridDescriptionPaneStyle" TargetType="primitives:PropertyGridDescriptionPane">
        <Setter Property="MinHeight" Value="{ThemeResource PropertyGridDescriptionPaneHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:PropertyGridDescriptionPane">
                    <Border
                        Padding="8,6,8,8"
                        Background="{ThemeResource PropertyGridDescriptionPaneBackgroundBrush}"
                        BorderBrush="{ThemeResource PropertyGridDescriptionPaneBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ValidationStates">
                                <VisualState x:Name="Valid" />
                                <VisualState x:Name="Invalid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Text.Foreground" Value="{ThemeResource PropertyGridErrorForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel>
                            <TextBlock
                                x:Name="PART_Title"
                                Foreground="{ThemeResource PropertyGridDescriptionTitleForegroundBrush}"
                                Style="{ThemeResource PropertyGridCategoryTextStyle}"
                                Text="{TemplateBinding Title}" />
                            <TextBlock
                                x:Name="PART_Text"
                                Foreground="{ThemeResource PropertyGridDescriptionForegroundBrush}"
                                Style="{ThemeResource PropertyGridDescriptionTextStyle}"
                                Text="{TemplateBinding Text}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

